# secrets-config (U16) — environment variable shapes.
# SEC-3: PLACEHOLDERS ONLY — never commit a real value. Copy this file to `.env` for
# local dev (`.env` is gitignored). `deploy-config` wires the real per-environment
# values (dev / CI / Render). A missing or invalid required var fails `Settings()` at
# startup (fail-closed).

# --- Phase-1 REQUIRED (all six; validated at construction) ---------------------------
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/CHANGE_ME
AUDIT_WRITER_URL=postgresql://audit_writer:CHANGE_ME@CHANGE_ME:5432/CHANGE_ME
AUDIT_READER_URL=postgresql://audit_reader:CHANGE_ME@CHANGE_ME:5432/CHANGE_ME
AUDIT_WRITER_PASSWORD=CHANGE_ME
AUDIT_READER_PASSWORD=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME

# --- Phase-2 RESERVED (memo-extensions / observability author these at their own FD;
#     NOT required in Phase 1 — reserved-not-authored, BR-SEC-6) ---------------------
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# --- NON-SECRET behavioural switch (register #18 — NOT a credential) ------------------
# ⚑ ALLOW_REAL_LLM_CALLS is an on/off switch controlling whether the OPT-IN real-LLM path
# (`backend/scripts/seed_demo_cases.py --real-llm`) may issue REAL, billable Gemini calls. It is
# deliberately kept OUT of the credential block above because it is NOT a secret: it is read from
# os.environ directly inside `backend/app/llm_client.py`'s factory (Confirm 2), never via
# secrets-config, and it is never conflated with GEMINI_API_KEY's retrieval path. It must be the
# EXACT string "true" to permit spend; anything else fails closed. Leave it UNSET for all
# offline/default use — the full test suite never reads it.
# ALLOW_REAL_LLM_CALLS=true
